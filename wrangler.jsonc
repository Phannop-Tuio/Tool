{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tool-inventory-app",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tool-inventory-db",
      "database_id": "2ef9e861-29a5-46cd-8383-1553c8ef57f4",
      "migrations_dir": "migrations"
    }
 // ปิด R2 ไว้ชั่วคราว
//],
//  "r2_buckets": [
  //  {
  //    "binding": "PHOTOS",
      "bucket_name": "tool-inventory-photos"
 //   }
 // ]
}
